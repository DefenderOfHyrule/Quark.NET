<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quark.SudoPasswordDialog"
        Title="Authenticate"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBg}">

    <Border Padding="20" BorderThickness="0">
        <StackPanel Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock Text="Setup udev rule"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Quark needs your sudo password to install the udev rule that lets it access the Leaflet device over USB without root."
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBox x:Name="PasswordBox"
                     Watermark="sudo password"
                     PasswordChar="•"
                     FontSize="13"
                     Padding="10,8"
                     Background="{DynamicResource CardInner}"
                     BorderBrush="{DynamicResource CardInnerBorder}"
                     Foreground="{DynamicResource TextPrimary}"
                     CornerRadius="6"/>

            <TextBlock x:Name="ErrorText"
                       FontSize="11.5"
                       Foreground="{DynamicResource AccentRed}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="{DynamicResource ButtonBg}"
                        Foreground="{DynamicResource TextPrimary}"/>
                <Button x:Name="ConfirmButton"
                        Content="Install"
                        Padding="14,6"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        Background="{DynamicResource UpdateAccent}"
                        Foreground="White"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
